# Copy to .env (git-ignored). In AWS the ECS task definition sets these, with credentials from Secrets Manager.
LOG_LEVEL=debug
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow_app
DB_PASSWORD=local-app-password-0001
DB_SSL=false
DB_POOL_MAX=10

# For `yarn migrate:dev`, which swaps in the compose.yaml master credentials.
APP_DB_USER=taskflow_app
APP_DB_PASSWORD=local-app-password-0001
